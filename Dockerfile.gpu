FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system finflow && useradd --system --gid finflow --home-dir /app finflow
COPY requirements-training.txt requirements.txt requirements-gpu.txt /app/
RUN awk '!/^sympy==/ && !/^PyYAML==/ && !/^-r requirements.txt$/' /app/requirements.txt /app/requirements-training.txt \
      > /tmp/finflow-gpu-requirements.txt \
    && cat /app/requirements-gpu.txt >> /tmp/finflow-gpu-requirements.txt \
    && pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cu124 \
    --extra-index-url https://pypi.org/simple \
    --extra-index-url https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    --timeout 300 \
    -r /tmp/finflow-gpu-requirements.txt \
    && rm -f /tmp/finflow-gpu-requirements.txt
COPY backend /app/backend
COPY ml /app/ml
COPY scripts /app/scripts
RUN mkdir -p /data/uploads /models && chown -R finflow:finflow /app /data /models
RUN chmod 755 /app/scripts/gpu_worker_entrypoint.sh /app/scripts/validate_gpu_runtime.py
USER finflow
ENTRYPOINT ["/app/scripts/gpu_worker_entrypoint.sh"]
CMD ["python", "-m", "backend.worker"]
